                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Automatic updates" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Automatically check for new Ferdium releases" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding AutomaticUpdates}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Wrench24}"
                                                Visibility="{Binding AutomaticUpdates, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Include beta versions" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Receive early pre-release builds" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding BetaUpdates}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon CheckmarkCircle24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppVersionText, StringFormat='Current version: {0}'}" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button Appearance="Secondary" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Globe24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="About Ferdium" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Ferdium is open-source software based on Franz (Apache-2.0 License)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button Appearance="Secondary" Content="GitHub" Command="{Binding OpenFerdiumGitHubCommand}" />
                                </ui:CardControl>
                            </StackPanel>

                            <!-- ==================== 8. EXTENSIONS TAB ==================== -->
                            <StackPanel Visibility="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Extensions}">
                                <TextBlock Text="Install Browser Extensions" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />

                                <Border CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,10"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Install from Chrome Web Store, a .crx/.zip package, or an unpacked local folder."
                                                   FontSize="12.5"
                                                   Opacity="0.8"
                                                   Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:TextBox Grid.Column="0"
                                                        PlaceholderText="Paste Chrome Web Store URL or 32-character Extension ID..."
                                                        Text="{Binding WebStoreExtensionInput, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsInstallingExtension, Converter={StaticResource InverseBool}}"
                                                        Margin="0,0,8,0" />

                                            <ui:Button Grid.Column="1"
                                                       Appearance="Primary"
                                                       Content="Install"
                                                       Icon="{ui:SymbolIcon ArrowDownload20}"
                                                       IsEnabled="{Binding IsInstallingExtension, Converter={StaticResource InverseBool}}"
                                                       Command="{Binding InstallWebStoreExtensionCommand}" />
                                        </Grid>

                                        <WrapPanel>
                                            <ui:Button Appearance="Secondary"
                                                       Margin="0,0,8,6"
                                                       Icon="{ui:SymbolIcon ShieldKeyhole20}"
                                                       Content="Install Bitwarden Password Manager"
                                                       Visibility="{Binding IsBitwardenInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                                       IsEnabled="{Binding IsInstallingExtension, Converter={StaticResource InverseBool}}"
                                                       Command="{Binding InstallBitwardenCommand}" />

                                            <ui:Button Appearance="Secondary"
                                                       Margin="0,0,8,6"
                                                       Icon="{ui:SymbolIcon Archive20}"
                                                       Content="Install .crx / .zip..."
                                                       IsEnabled="{Binding IsInstallingExtension, Converter={StaticResource InverseBool}}"
                                                       Command="{Binding InstallCrxExtensionCommand}" />

                                            <ui:Button Appearance="Secondary"
                                                       Margin="0,0,0,6"
                                                       Icon="{ui:SymbolIcon FolderOpen20}"
                                                       Content="Load Unpacked Folder..."
                                                       IsEnabled="{Binding IsInstallingExtension, Converter={StaticResource InverseBool}}"
                                                       Command="{Binding LoadUnpackedExtensionCommand}" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding ExtensionStatusMessage}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Extensions share a single browser profile and login session across all services by default. If you need a separate account for a specific service, right-click it and choose Session Sharing → Isolated."
                                                   FontSize="11.5"
                                                   Opacity="0.65"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Installed Extensions" Style="{StaticResource SettingsSectionHeader}" Margin="0,12,0,8" />

                                <Border CornerRadius="6"
                                        Padding="20"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        Visibility="{Binding HasNoExtensions, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="No extensions installed yet. Click 'Install Bitwarden Password Manager' above or add any Chrome extension to pin its icon to the title bar."
                                               FontSize="12.5"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding InstalledExtensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="36"
                                                            Height="36"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <Image Source="{Binding IconImage}"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding IconImage, Converter={StaticResource NullToVisibility}}" />
                                                            <ui:SymbolIcon Symbol="PuzzlePiece20"
                                                                           FontSize="18"
                                                                           Visibility="{Binding IconImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <Border Margin="8,0,0,0"
                                                                    Padding="6,1"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                <TextBlock Text="{Binding VersionBadge}" FontSize="11" Opacity="0.8" />
                                                            </Border>
                                                            <Border Margin="4,0,0,0"
                                                                    Padding="6,1"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                <TextBlock Text="{Binding SourceBadge}" FontSize="11" Opacity="0.8" />
                                                            </Border>
                                                            <Border Margin="4,0,0,0"
                                                                    Padding="6,1"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                <TextBlock Text="{Binding ManifestBadge}" FontSize="11" Opacity="0.8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   Opacity="0.7"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                                                   Width="32"
                                                                   Height="32"
                                                                   Padding="0"
                                                                   Margin="0,0,4,0"
                                                                   ToolTip="Extension options"
                                                                   Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}"
                                                                   Command="{Binding DataContext.OpenExtensionOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="Settings20" FontSize="15" />
                                                        </ui:Button>

                                                        <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                         Margin="0,0,8,0"
                                                                         VerticalAlignment="Center" />

                                                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                                                   Width="32"
                                                                   Height="32"
                                                                   Padding="0"
                                                                   ToolTip="Remove extension"
                                                                   Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="15" />
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 1. Quick Switch (Ctrl+K) Command Palette -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsQuickSwitchOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="540"
                    MaxHeight="460"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0"
                    CornerRadius="8"
                    Padding="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:SearchTextBox x:Name="QuickSwitchInput"
                                            Grid.Row="0"
                                            Icon="{ui:SymbolIcon Search20}"
                                            PlaceholderText="Jump to any service..."
                                            Text="{Binding QuickSwitchQuery, UpdateSourceTrigger=PropertyChanged}"
                                            PreviewKeyDown="QuickSwitchInput_PreviewKeyDown" />

                    <ListBox x:Name="QuickSwitchList"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             MaxHeight="340"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding QuickSwitchResults}"
                             SelectedItem="{Binding SelectedQuickSwitchItem, Mode=TwoWay}"
                             PreviewKeyDown="QuickSwitchInput_PreviewKeyDown"
                             PreviewMouseWheel="QuickSwitchList_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2,14,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="QuickSwitchItem_Click" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Border x:Name="SelectionPill"
                                                            Width="3"
                                                            Height="18"
                                                            CornerRadius="2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="-6,0,0,0"
                                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="28" Height="28">
                                        <Image Source="{Binding IconImage}"
                                               Width="24"
                                               Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="{Binding AccentBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                            <TextBlock Text="{Binding Monogram}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusLabel}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Add Service Catalog Dialog -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsAddServiceOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="740"
                    MaxHeight="620"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Add Service"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   HorizontalAlignment="Right"
                                   Width="32"
                                   Height="32"
                                   Padding="0"
                                   Command="{Binding CloseAllOverlaysCommand}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <controls:SearchTextBox Grid.Row="1"
                                            Margin="0,0,0,14"
                                            Icon="{ui:SymbolIcon Search20}"
                                            PlaceholderText="Search WhatsApp, Slack, Discord, Gmail, Notion..."
                                            Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding CatalogResults}" Margin="0,0,18,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Appearance="Secondary"
                                               Margin="4"
                                               Padding="12,10"
                                               CornerRadius="6"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Command="{Binding DataContext.AddFromCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="30" Height="30">
                                                <Image Source="{Binding Url, Converter={StaticResource UrlToFaviconUri}}"
                                                       Width="26"
                                                       Height="26"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Category}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Custom URL quick-add -->
                    <Border Grid.Row="3"
                            Margin="0,16,0,0"
                            Padding="14"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Custom name"
                                        Text="{Binding CustomServiceName, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="1"
                                        Margin="8,0"
                                        PlaceholderText="https://your-web-app.com"
                                        Text="{Binding CustomServiceUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="2"
                                       Appearance="Primary"
                                       Content="Add Custom"
                                       Command="{Binding AddCustomServiceCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Workspaces Dialog -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsWorkspacesOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="460"
                    MaxHeight="520"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Workspaces"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   HorizontalAlignment="Right"
                                   Width="32"
                                   Height="32"
                                   Padding="0"
                                   Command="{Binding CloseAllOverlaysCommand}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Workspaces}" Margin="0,0,18,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   Style="{StaticResource WinUiSubtleButton}"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   Padding="12,10"
                                                   Command="{Binding DataContext.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock Text="{Binding ServiceCount, StringFormat='{}{0} services'}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </ui:Button>
                                        <ui:Button Grid.Column="1"
                                                   Style="{StaticResource WinUiSubtleButton}"
                                                   Width="32"
                                                   Height="32"
                                                   Padding="0"
                                                   Margin="4,0,0,0"
                                                   Visibility="{Binding IsAllServices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                                   Command="{Binding DataContext.DeleteWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Delete Workspace">
                                            <ui:SymbolIcon Symbol="Delete20" FontSize="15" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    PlaceholderText="New workspace name..."
                                    Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Margin="8,0,0,0"
                                   Content="Create"
                                   Command="{Binding CreateWorkspaceCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Share Login Session Dialog -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsSessionShareOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="480"
                    MaxHeight="560"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Share Login Session"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SessionShareTargetService.Name, StringFormat='Choose which login cookies {0} uses'}"
                                       FontSize="12.5"
                                       Margin="0,3,36,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Width="32"
                                   Height="32"
                                   Padding="0"
                                   Command="{Binding CloseAllOverlaysCommand}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding SessionShareOptions}" Margin="0,0,18,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch"
                                               Margin="0,2"
                                               Padding="12,10"
                                               Command="{Binding DataContext.ApplySessionShareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Image Source="{Binding IconImage}"
                                                       Width="22"
                                                       Height="22"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <ui:SymbolIcon Symbol="PersonAccounts20"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <ui:SymbolIcon Grid.Column="2"
                                                           Symbol="Checkmark20"
                                                           FontSize="16"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="0,14,0,0"
                               Text="Services sharing a session share cookies and logins (such as Google SSO) and reuse one browser profile to save RAM. Switching profiles reloads the service."
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Edit Service / Configure New Service / Add Another Account Dialog -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsEditServiceOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="540"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="40" Margin="0,0,12,0">
                                <Image Source="{Binding EditServiceTarget.IconImage}"
                                       Width="34"
                                       Height="34"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-2,-2"
                                        MinWidth="18"
                                        Height="18"
                                        Padding="4,0"
                                        CornerRadius="9"
                                        BorderThickness="1.5"
                                        BorderBrush="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                        Background="{Binding EditPreviewBadgeBrush}"
                                        Visibility="{Binding EditPreviewHasBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding EditPreviewBadgeText}"
                                               Foreground="White"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditServiceDialogTitle}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EditServiceTarget.Url}"
                                           FontSize="11.5"
                                           MaxWidth="380"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Width="32"
                                   Height="32"
                                   Padding="0"
                                   Command="{Binding CloseAllOverlaysCommand}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <!-- Scrollable Options Body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="0,0,18,4">
                            <!-- Identity & Account -->
                            <TextBlock Text="Service Name" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:TextBox PlaceholderText="e.g. Instagram"
                                        Text="{Binding EditServiceName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Account Label" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ui:TextBox PlaceholderText="e.g. Personal, Work, @handle"
                                                Text="{Binding EditAccountLabel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Corner Badge" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ui:TextBox MaxLength="3"
                                                PlaceholderText="Auto"
                                                Text="{Binding EditAccountBadge, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Badge Color" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AccountBadgeColorPresets}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Width="26"
                                                   Height="26"
                                                   Padding="0"
                                                   Margin="0,0,8,0"
                                                   CornerRadius="13"
                                                   BorderThickness="0"
                                                   Background="{Binding Converter={StaticResource HexToBrush}}"
                                                   Command="{Binding DataContext.SelectEditBadgeColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox IsChecked="{Binding EditIsolateSession}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Separate login session (isolated account)" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Keep this account's cookies completely separate from other accounts"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <!-- Section: Startup & Hibernation -->
                            <Border CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Power20" FontSize="15" Margin="0,0,8,0" />
                                        <TextBlock Text="Startup &amp; Hibernation" FontSize="13.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding EditLoadOnStartup}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Load on start-up" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock Text="Preload this service automatically when Ferdium starts (even with Lazy Load on)"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding EditHibernateOnStartup}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Hibernate on start-up" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock Text="Keep this service unloaded on launch until you click it"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding EditNeverHibernate}">
                                        <StackPanel>
                                            <TextBlock Text="Never hibernate" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock Text="Exempt this service from auto-hibernation and bulk hibernate so notifications stay live"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Section: Mute & Notifications Panel -->
                            <Border CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="AlertOff20" FontSize="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Mute &amp; Notifications" FontSize="13.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding EditMuteSnoozeSummary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding EditIsMuted}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Mute all (notifications &amp; audio)" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="Master mute switch for this service"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <Border Margin="12,2,0,10"
                                            Padding="10,6,0,4"
                                            BorderThickness="2,0,0,0"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding EditMuteNotifications}"
                                                      Content="Suppress desktop toast notifications"
                                                      FontSize="12.5"
                                                      Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding EditMuteNotificationSound}"
                                                      Content="Silent notifications (show popup without sound)"
                                                      FontSize="12.5"
                                                      Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding EditMuteAudio}"
                                                      Content="Mute service audio (calls, videos, in-app chimes)"
                                                      FontSize="12.5"
                                                      Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding EditHideUnreadBadge}"
                                                      Content="Hide unread badge count on sidebar &amp; tray"
                                                      FontSize="12.5"
                                                      Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding EditHideNotificationPreview}"
                                                      Content="Hide message preview (private notifications)"
                                                      FontSize="12.5" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Snooze notifications"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <ui:Button Content="Off" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                   Command="{Binding SetEditMuteSnoozeCommand}" CommandParameter="off" />
                                        <ui:Button Content="15 min" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                   Command="{Binding SetEditMuteSnoozeCommand}" CommandParameter="15m" />
                                        <ui:Button Content="1 hour" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                   Command="{Binding SetEditMuteSnoozeCommand}" CommandParameter="1h" />
                                        <ui:Button Content="4 hours" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                   Command="{Binding SetEditMuteSnoozeCommand}" CommandParameter="4h" />
                                        <ui:Button Content="Tomorrow 9 AM" Padding="10,4" Margin="0,0,0,4" FontSize="11.5"
                                                   Command="{Binding SetEditMuteSnoozeCommand}" CommandParameter="tomorrow" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section: Service Lock (Passcode / Password / Windows Hello) -->
                            <Border CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="15" Margin="0,0,8,0" />
                                        <TextBlock Text="Service Lock" FontSize="13.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock Text="Lock Method" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox SelectedIndex="{Binding EditLockModeIndex}" Margin="0,0,0,10">
                                        <ComboBoxItem Content="None (unlocked)" />
                                        <ComboBoxItem Content="Passcode (numeric PIN)" />
                                        <ComboBoxItem Content="Password" />
                                        <ComboBoxItem Content="Windows Hello (PIN / Fingerprint / Face)" />
                                    </ComboBox>

                                    <!-- Passcode / Password fields -->
                                    <StackPanel Visibility="{Binding EditIsSecretLockMode, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="{Binding EditLockSecretPlaceholder}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <PasswordBox x:Name="EditLockSecretBox"
                                                     Padding="8,6"
                                                     Margin="0,0,0,8"
                                                     PasswordChanged="EditLockSecretBox_PasswordChanged" />

                                        <TextBlock Text="Confirm passcode / password"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <PasswordBox x:Name="EditLockSecretConfirmBox"
                                                     Padding="8,6"
                                                     PasswordChanged="EditLockSecretConfirmBox_PasswordChanged" />
                                    </StackPanel>

                                    <!-- Windows Hello note -->
                                    <TextBlock Text="Uses your Windows Hello credentials (PIN, fingerprint, or face) to unlock this service."
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding EditIsWindowsHelloLockMode, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Auto-lock & Re-lock options -->
                                    <StackPanel Visibility="{Binding EditIsAnyLockMode, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,4,0,0">
                                        <Border Height="1"
                                                Margin="0,2,0,10"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                        <TextBlock Text="Auto-Lock"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <CheckBox IsChecked="{Binding EditAutoLockEnabled}"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Enable auto-lock after inactivity" FontSize="12.5" FontWeight="Medium" />
                                                <TextBlock Text="{Binding EditAutoLockSummary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Border Margin="12,0,0,10"
                                                Padding="10,6,0,4"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                                Visibility="{Binding EditAutoLockEnabled, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="Auto-lock duration"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,6" />
                                                <WrapPanel Margin="0,0,0,6">
                                                    <ui:Button Content="1 min" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                               Command="{Binding SetEditAutoLockMinutesCommand}" CommandParameter="1" />
                                                    <ui:Button Content="5 min" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                               Command="{Binding SetEditAutoLockMinutesCommand}" CommandParameter="5" />
                                                    <ui:Button Content="15 min" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                               Command="{Binding SetEditAutoLockMinutesCommand}" CommandParameter="15" />
                                                    <ui:Button Content="30 min" Padding="10,4" Margin="0,0,6,4" FontSize="11.5"
                                                               Command="{Binding SetEditAutoLockMinutesCommand}" CommandParameter="30" />
                                                    <ui:Button Content="60 min" Padding="10,4" Margin="0,0,0,4" FontSize="11.5"
                                                               Command="{Binding SetEditAutoLockMinutesCommand}" CommandParameter="60" />
                                                </WrapPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0"
                                                            Minimum="1"
                                                            Maximum="120"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding EditAutoLockMinutes}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding EditAutoLockMinutes, StringFormat='{}{0} min'}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <CheckBox IsChecked="{Binding EditRelockOnSwitchAway}"
                                                  Content="Re-lock automatically when switching to another service"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />

                                        <CheckBox IsChecked="{Binding EditRelockOnMinimize}"
                                                  Content="Re-lock when Ferdium is minimized or hidden to tray"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />

                                        <CheckBox IsChecked="{Binding EditRelockOnSystemSuspend}"
                                                  Content="Re-lock when Windows sleeps or locks"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />

                                        <CheckBox IsChecked="{Binding EditHideNotificationContentWhenLocked}"
                                                  Content="Hide notification content while locked"
                                                  FontSize="12.5" />
                                    </StackPanel>

                                    <!-- Validation error -->
                                    <TextBlock Text="{Binding EditLockValidationError}"
                                               Foreground="#FF6B72"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasEditLockValidationError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <ui:Button Content="Cancel"
                                   Margin="0,0,8,0"
                                   Command="{Binding CloseAllOverlaysCommand}" />
                        <ui:Button Appearance="Primary"
                                   Content="{Binding EditServiceSaveButtonText}"
                                   Command="{Binding SaveEditServiceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Unlock Service Dialog -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="{Binding IsServiceUnlockOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="400"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="28"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Image Source="{Binding UnlockTargetService.IconImage}"
                               Width="46"
                               Height="46"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                            <ui:SymbolIcon Symbol="LockClosed16" FontSize="12" Foreground="White" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding UnlockTargetService.DisplayName}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="19"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UnlockPromptSubtitle}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,4,0,18"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Passcode / Password unlock input -->
                    <StackPanel Visibility="{Binding IsUnlockSecretMode, Converter={StaticResource BoolToVisibility}}">
                        <PasswordBox x:Name="UnlockSecretBox"
                                     Padding="10,8"
                                     Margin="0,0,0,12"
                                     PasswordChanged="UnlockSecretBox_PasswordChanged"
                                     KeyDown="UnlockSecretBox_KeyDown" />
                        <ui:Button Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   Content="Unlock"
                                   Command="{Binding SubmitServiceUnlockCommand}" />
                    </StackPanel>

                    <!-- Windows Hello unlock button -->
                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Content="Unlock with Windows Hello"
                               Visibility="{Binding IsUnlockWindowsHelloMode, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding SubmitServiceUnlockCommand}" />

                    <TextBlock Text="{Binding UnlockErrorMessage}"
                               Foreground="#FF6B72"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasUnlockError, Converter={StaticResource BoolToVisibility}}" />

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Content="Cancel"
                               Command="{Binding CloseAllOverlaysCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Global App Password Lock Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#CC000000"
              Visibility="{Binding IsAppLocked, Converter={StaticResource BoolToVisibility}}">
            <Border Width="380"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="28"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="36" Margin="0,0,0,12" HorizontalAlignment="Center" />
                    <TextBlock Text="Ferdium is Locked"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Enter your password to unlock"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,16" />
                    <ui:TextBox PlaceholderText="Password"
                                Text="{Binding AppLockPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10" />
                    <TextBlock Text="{Binding AppLockErrorText}"
                               Foreground="#FF6B72"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Content="Unlock"
                               Command="{Binding UnlockAppCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
