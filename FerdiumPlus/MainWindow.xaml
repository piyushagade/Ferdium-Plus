<ui:FluentWindow x:Class="FerdiumApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:FerdiumApp.Controls"
                 Title="Ferdium Plus"
                 Icon="pack://application:,,,/Assets/app-icon.ico"
                 Width="1320"
                 Height="840"
                 MinWidth="880"
                 MinHeight="580"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ui:FluentWindow.Resources>
        <!-- True WinUI 3 borderless subtle icon button style -->
        <Style x:Key="WinUiSubtleButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- WinUI 3 Settings section header -->
        <Style x:Key="SettingsSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <!-- WinUI 3 SettingsCard spacing -->
        <Style x:Key="WinUiSettingsCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== WINUI 3 TITLE BAR ==================== -->
        <Grid Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBarDragArea_MouseLeftButtonDown">
            <ui:TitleBar x:Name="RootTitleBar"
                         Title=""
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True"
                         HorizontalAlignment="Right"
                         Height="46" />

            <!-- Left: App Icon + Title + Workspace Switcher -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="16,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <ui:Button Style="{StaticResource WinUiSubtleButton}"
                           Width="30"
                           Height="30"
                           Padding="0"
                           Margin="0,0,6,0"
                           Command="{Binding ToggleSidebarCollapsedCommand}"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Expand Sidebar">
                    <ui:SymbolIcon Symbol="PanelLeft20" FontSize="16" />
                </ui:Button>

                <Image Source="pack://application:,,,/Assets/app-icon.png"
                       Width="22"
                       Height="22"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <TextBlock Text="Ferdium Plus"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="9,0,14,0" />

                <ui:Button x:Name="TitleBarWorkspacesButton"
                           Style="{StaticResource WinUiSubtleButton}"
                           Height="30"
                           Padding="10,0"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Command="{Binding OpenWorkspacesCommand}"
                           Visibility="{Binding HideWorkspacesButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                           ToolTip="Switch or manage workspaces">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="Grid20" FontSize="15" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ActiveWorkspace.Name, FallbackValue='All Services'}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Margin="6,1,0,0" Opacity="0.7" />
                    </StackPanel>
                </ui:Button>

                <!-- Left: Browser Extensions Dropdown Button -->
                <ui:Button x:Name="TitleBarExtensionsManageButton"
                           Style="{StaticResource WinUiSubtleButton}"
                           Height="30"
                           Padding="8,0"
                           Margin="4,0,0,0"
                           Click="ExtensionsManageButton_Click"
                           ToolTip="Browser Extensions">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="PuzzlePiece20" FontSize="15" Opacity="0.85" />
                        <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Margin="4,1,0,0" Opacity="0.7" />
                    </StackPanel>
                </ui:Button>

                <!-- Left: Quick Lock button (visible when active service has a lock configured) -->
                <ui:Button x:Name="TitleBarQuickLockButton"
                           Style="{StaticResource WinUiSubtleButton}"
                           Height="30"
                           Padding="10,0"
                           Margin="4,0,0,0"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Command="{Binding LockActiveServiceCommand}"
                           Visibility="{Binding CanQuickLockActiveService, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="{Binding QuickLockTooltip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Margin="0,0,6,0" Opacity="0.9" />
                        <TextBlock Text="Lock" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <Popup x:Name="ExtensionsDropdownPopup"
                       PlacementTarget="{Binding ElementName=TitleBarExtensionsManageButton}"
                       Placement="Bottom"
                       VerticalOffset="4"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border MinWidth="240"
                            MaxWidth="300"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,0,8,8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.32" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Extensions"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"
                                       Margin="8,4,8,6" />

                            <TextBlock Text="No enabled extensions"
                                       FontSize="12"
                                       Opacity="0.55"
                                       Margin="8,4,8,8"
                                       Visibility="{Binding HasNoEnabledExtensions, Converter={StaticResource BoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding EnabledExtensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Left"
                                                   Height="34"
                                                   Padding="8,0"
                                                   Margin="0,1"
                                                   Tag="{Binding}"
                                                   Click="TitleBarExtensionButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="18" Height="18" Margin="0,0,10,0">
                                                    <Image Source="{Binding IconImage}"
                                                           Width="16"
                                                           Height="16"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding IconImage, Converter={StaticResource NullToVisibility}}" />
                                                    <ui:SymbolIcon Symbol="PuzzlePiece20"
                                                                   FontSize="15"
                                                                   Visibility="{Binding IconImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="6,6" Opacity="0.35" />

                            <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Height="34"
                                       Padding="8,0"
                                       Click="ExtensionsDropdownManage_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings20" FontSize="15" Margin="0,0,10,0" Opacity="0.8" />
                                    <TextBlock Text="Manage extensions..." FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- Center: WinUI 3 Search / Quick Switch Pill -->
            <ui:Button x:Name="TitleBarSearchButton"
                       Appearance="Secondary"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="340"
                       Height="30"
                       Padding="12,0"
                       CornerRadius="6"
                       HorizontalContentAlignment="Stretch"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       Command="{Binding OpenQuickSwitchCommand}"
                       ToolTip="Quick Switch (Ctrl+K)">
                <Grid IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Search20" FontSize="14" Opacity="0.7" Margin="0,0,8,0" />
                        <TextBlock Text="Search services..." FontSize="12.5" Opacity="0.65" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="6,1"
                            CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="Ctrl+K" FontSize="10.5" Opacity="0.7" />
                    </Border>
                </Grid>
            </ui:Button>
        </Grid>

        <!-- ==================== MAIN SHELL BODY ==================== -->
        <Grid x:Name="ShellBodyGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- WinUI 3 Top Horizontal NavigationView Rail (same appearance as vertical rail) -->
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Height="{Binding ServiceRibbonWidth}"
                  Margin="8,0,8,4"
                  Visibility="{Binding ShowHorizontalSidebar, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Horizontal Service Tabs -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleServices}"
                                  HorizontalAlignment="{Binding EffectiveSidebarServicesHorizontalAlignment}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0" Opacity="{Binding DragOpacity}">
                                    <!-- Signature WinUI 3 3px Active Accent Pill (horizontal bottom) -->
                                    <Border Height="3"
                                            Width="20"
                                            CornerRadius="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               VerticalAlignment="Stretch"
                                               VerticalContentAlignment="Center"
                                               Padding="{Binding DataContext.EffectiveSidebarItemPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="0,2,0,4"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Command="{Binding DataContext.ActivateServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <ui:Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Opacity="0.75" />
                                                <TextBlock Text="{Binding SessionBadgeLabel}"
                                                           FontSize="10.5"
                                                           Opacity="0.8"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasSharedSession, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </ui:Button.ToolTip>
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Reload"
                                                          Command="{Binding PlacementTarget.Tag.ReloadServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding HibernateMenuLabel}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleHibernateServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding MuteMenuLabel}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleServiceMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Edit Service / Account…"
                                                          Command="{Binding PlacementTarget.Tag.OpenEditServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Add Another Account…"
                                                          Command="{Binding PlacementTarget.Tag.OpenAddAnotherAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Share Login Session…"
                                                          Command="{Binding PlacementTarget.Tag.OpenSessionShareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Lock Service"
                                                          Visibility="{Binding CanLockNow, Converter={StaticResource BoolToVisibility}}"
                                                          Command="{Binding PlacementTarget.Tag.LockServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding EnableMenuLabel}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleServiceEnabledCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Open DevTools"
                                                          Command="{Binding PlacementTarget.Tag.OpenDevToolsForServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Remove Service"
                                                          Command="{Binding PlacementTarget.Tag.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="{Binding DataContext.EffectiveIconBoxSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding DataContext.EffectiveIconBoxSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Opacity="{Binding DataContext.EffectiveServiceIconDimOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <!-- Real Brand Icon -->
                                                <Image Source="{Binding IconImage}"
                                                       Width="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Height="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="{Binding IsHibernated, Converter={StaticResource HibernatedOpacity}}"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />

                                                <!-- Fallback Monogram -->
                                                <Border Width="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Height="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CornerRadius="7"
                                                        Background="{Binding AccentBrush}"
                                                        Opacity="{Binding IsHibernated, Converter={StaticResource HibernatedOpacity}}"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                                    <TextBlock Text="{Binding Monogram}"
                                                               Foreground="White"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Unread Count Badge -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-3,-3,0"
                                                        MinWidth="17"
                                                        Height="17"
                                                        Padding="4,0"
                                                        CornerRadius="9"
                                                        Background="#E74856"
                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Indirect Activity Dot -->
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#E74856"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Visibility="{Binding HasIndirectDot, Converter={StaticResource BoolToVisibility}}" />

                                                <!-- Multi-Account Corner Badge Pill -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,-4,-3"
                                                        MinWidth="16"
                                                        Height="16"
                                                        Padding="3,0"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                        Background="{Binding AccountBadgeBrush}"
                                                        Visibility="{Binding HasAccountBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding AccountBadgeText}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Locked Service Indicator -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="-3,-3,0,0"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                        Background="#3A3F4B"
                                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                                    <ui:SymbolIcon Symbol="LockClosed16"
                                                                   FontSize="9"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,4,0"
                                                       MaxWidth="112"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Visibility="{Binding DataContext.ShowServiceNames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Right-Side Horizontal Footer Actions (mirrors vertical sidebar footer) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Width="1"
                            Height="22"
                            Margin="2,0,8,0"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding OpenAddServiceCommand}"
                               Visibility="{Binding HideRecipesButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Add Service">
                        <ui:SymbolIcon Symbol="AddSquare20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding ToggleGlobalMuteCommand}"
                               Visibility="{Binding HideNotificationsButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Mute / Unmute All Audio &amp; Notifications">
                        <Grid>
                            <ui:SymbolIcon Symbol="Alert20" FontSize="17"
                                           Visibility="{Binding IsGlobalMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                            <ui:SymbolIcon Symbol="AlertOff20" FontSize="17" Foreground="#E74856"
                                           Visibility="{Binding IsGlobalMuted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding ToggleSplitModeCommand}"
                               Visibility="{Binding HideSplitModeButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Toggle Split Mode">
                        <ui:SymbolIcon Symbol="Grid20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding OpenDownloadsFolderCommand}"
                               Visibility="{Binding HideDownloadButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Open Downloads Folder">
                        <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding ToggleTodosDrawerCommand}"
                               Visibility="{Binding EnableTodos, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Toggle Ferdium Todos">
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding LockAppCommand}"
                               Visibility="{Binding IsLockingFeatureEnabled, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Lock Ferdium (Ctrl+Shift+L)">
                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding HibernateInactiveServicesCommand}"
                               ToolTip="Hibernate Inactive Services (Free RAM)">
                        <ui:SymbolIcon Symbol="Broom20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               Width="36" Height="36" Padding="0" Margin="1,0"
                               Command="{Binding ToggleSidebarCollapsedCommand}"
                               Visibility="{Binding HideCollapseButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Collapse Sidebar">
                        <ui:SymbolIcon Symbol="PanelLeft20" FontSize="17" />
                    </ui:Button>

                    <Grid Margin="1,0"
                          Visibility="{Binding HideSettingsButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <Border Height="3" Width="18" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   Width="36" Height="36" Padding="0"
                                   Command="{Binding OpenSettingsCommand}"
                                   ToolTip="Settings (Ctrl+,)">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="17" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- WinUI 3 Left NavigationView Rail -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Width="{Binding EffectiveSidebarWidth}"
                  MinWidth="{Binding ServiceRibbonWidth}"
                  Margin="0,2,0,10"
                  Visibility="{Binding ShowVerticalSidebar, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Service Tabs -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleServices}"
                                  VerticalAlignment="{Binding EffectiveSidebarServicesVerticalAlignment}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2"
                                      Opacity="{Binding DragOpacity}"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="ServiceItem_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="ServiceItem_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="ServiceItem_PreviewMouseLeftButtonUp"
                                      DragOver="ServiceItem_DragOver"
                                      DragLeave="ServiceItem_DragLeave"
                                      Drop="ServiceItem_Drop">
                                    <!-- Top / Bottom Drag-and-Drop Insertion Indicators -->
                                    <Border Height="2"
                                            Margin="8,-2,6,0"
                                            CornerRadius="1"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            Visibility="{Binding IsDropTargetBefore, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Height="2"
                                            Margin="8,0,6,-2"
                                            CornerRadius="1"
                                            VerticalAlignment="Bottom"
                                            IsHitTestVisible="False"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            Visibility="{Binding IsDropTargetAfter, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Signature WinUI 3 3px Active Accent Pill -->
                                    <Border Width="3"
                                            Height="20"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"
                                               Padding="{Binding DataContext.EffectiveSidebarItemPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Margin="4,0,2,0"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Command="{Binding DataContext.ActivateServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <ui:Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Opacity="0.75" />
                                                <TextBlock Text="{Binding SessionBadgeLabel}"
                                                           FontSize="11"
                                                           Opacity="0.85"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding HasSharedSession, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </ui:Button.ToolTip>
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Reload"
                                                          Command="{Binding PlacementTarget.Tag.ReloadServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding HibernateMenuLabel}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleHibernateServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding MuteMenuLabel}"
                                                          IsChecked="{Binding IsMuted, Mode=OneWay}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleServiceMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Edit Service / Account…"
                                                          Command="{Binding PlacementTarget.Tag.OpenEditServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Add Another Account…"
                                                          Command="{Binding PlacementTarget.Tag.OpenAddAnotherAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Share Login Session…"
                                                          Command="{Binding PlacementTarget.Tag.OpenSessionShareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Lock Service"
                                                          Visibility="{Binding CanLockNow, Converter={StaticResource BoolToVisibility}}"
                                                          Command="{Binding PlacementTarget.Tag.LockServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding EnableMenuLabel}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleServiceEnabledCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Open DevTools"
                                                          Command="{Binding PlacementTarget.Tag.OpenDevToolsForServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Remove Service"
                                                          Command="{Binding PlacementTarget.Tag.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="{Binding DataContext.EffectiveIconBoxSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding DataContext.EffectiveIconBoxSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Opacity="{Binding DataContext.EffectiveServiceIconDimOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <!-- Real Brand Icon -->
                                                <Image Source="{Binding IconImage}"
                                                       Width="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Height="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="{Binding IsHibernated, Converter={StaticResource HibernatedOpacity}}"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />

                                                <!-- Fallback Monogram (only while loading or offline) -->
                                                <Border Width="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Height="{Binding DataContext.EffectiveIconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CornerRadius="7"
                                                        Background="{Binding AccentBrush}"
                                                        Opacity="{Binding IsHibernated, Converter={StaticResource HibernatedOpacity}}"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                                    <TextBlock Text="{Binding Monogram}"
                                                               Foreground="White"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Unread Count Badge -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-3,-3,0"
                                                        MinWidth="17"
                                                        Height="17"
                                                        Padding="4,0"
                                                        CornerRadius="9"
                                                        Background="#E74856"
                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Indirect Activity Dot -->
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#E74856"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Visibility="{Binding HasIndirectDot, Converter={StaticResource BoolToVisibility}}" />

                                                <!-- Multi-Account Corner Badge Pill -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,-4,-3"
                                                        MinWidth="16"
                                                        Height="16"
                                                        Padding="3,0"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                        Background="{Binding AccountBadgeBrush}"
                                                        Visibility="{Binding HasAccountBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding AccountBadgeText}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Locked Service Indicator -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="-3,-3,0,0"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                        Background="#3A3F4B"
                                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                                    <ui:SymbolIcon Symbol="LockClosed16"
                                                                   FontSize="9"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="10,0,4,0"
                                                       MaxWidth="104"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Visibility="{Binding DataContext.ShowServiceNames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom Sidebar Actions (True Borderless WinUI 3 Footer Items) -->
                <StackPanel Grid.Row="1" Margin="4,8,2,0">
                    <Border Height="1"
                            Margin="4,0,4,8"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding OpenAddServiceCommand}"
                               Visibility="{Binding HideRecipesButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Add Service">
                        <ui:SymbolIcon Symbol="AddSquare20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding ToggleGlobalMuteCommand}"
                               Visibility="{Binding HideNotificationsButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Mute / Unmute All Audio &amp; Notifications">
                        <Grid>
                            <ui:SymbolIcon Symbol="Alert20"
                                           FontSize="17"
                                           Visibility="{Binding IsGlobalMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                            <ui:SymbolIcon Symbol="AlertOff20"
                                           FontSize="17"
                                           Foreground="#E74856"
                                           Visibility="{Binding IsGlobalMuted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding ToggleSplitModeCommand}"
                               Visibility="{Binding HideSplitModeButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Toggle Split Mode">
                        <ui:SymbolIcon Symbol="Grid20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding OpenDownloadsFolderCommand}"
                               Visibility="{Binding HideDownloadButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Open Downloads Folder">
                        <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding ToggleTodosDrawerCommand}"
                               Visibility="{Binding EnableTodos, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Toggle Ferdium Todos">
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding LockAppCommand}"
                               Visibility="{Binding IsLockingFeatureEnabled, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Lock Ferdium (Ctrl+Shift+L)">
                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding HibernateInactiveServicesCommand}"
                               ToolTip="Hibernate Inactive Services (Free RAM)">
                        <ui:SymbolIcon Symbol="Broom20" FontSize="17" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Padding="0"
                               Margin="0,1"
                               Command="{Binding ToggleSidebarCollapsedCommand}"
                               Visibility="{Binding HideCollapseButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               ToolTip="Collapse Sidebar">
                        <ui:SymbolIcon Symbol="PanelLeft20" FontSize="17" />
                    </ui:Button>

                    <Grid Margin="0,1"
                          Visibility="{Binding HideSettingsButton, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <!-- Active pill when Settings page is open -->
                        <Border Width="3"
                                Height="18"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-4,0,0,0"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                   HorizontalAlignment="Stretch"
                                   Height="38"
                                   Padding="0"
                                   Command="{Binding OpenSettingsCommand}"
                                   ToolTip="Settings (Ctrl+,)">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="17" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ==================== ELEVATED WINUI 3 CONTENT PANE ==================== -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="{Binding EffectiveWebviewPadding}"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- WebView2 is a rectangular Win32 HWND that cannot be clipped to rounded corners;
                             only round the top-left corner when the WPF WebControls bar occupies the top edge. -->
                        <Setter Property="CornerRadius" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowWebControls}" Value="True">
                                <Setter Property="CornerRadius" Value="{Binding EffectiveWebviewCornerRadius}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Docked Workspaces Drawer (when AlwaysShowWorkspaces is enabled) -->
                    <Border Grid.Column="0"
                            BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Padding="8,10"
                            Visibility="{Binding AlwaysShowWorkspaces, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="180" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseCompactWorkspaceDrawer}" Value="True">
                                        <Setter Property="Width" Value="116" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Workspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Left"
                                                   Padding="8,6"
                                                   Margin="0,2"
                                                   Command="{Binding DataContext.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Active Service View (WebControls + WebView2) -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Sleek Borderless WinUI 3 WebControls Bar -->
                        <Border Grid.Row="0"
                                Height="44"
                                Padding="10,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding ShowWebControls, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               Width="32"
                                               Height="32"
                                               Padding="0"
                                               IsEnabled="{Binding ActiveService.CanGoBack, FallbackValue=False}"
                                               Command="{Binding GoBackActiveServiceCommand}"
                                               ToolTip="Back">
                                        <ui:SymbolIcon Symbol="ArrowLeft20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               Width="32"
                                               Height="32"
                                               Padding="0"
                                               Margin="2,0,0,0"
                                               IsEnabled="{Binding ActiveService.CanGoForward, FallbackValue=False}"
                                               Command="{Binding GoForwardActiveServiceCommand}"
                                               ToolTip="Forward">
                                        <ui:SymbolIcon Symbol="ArrowRight20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               Width="32"
                                               Height="32"
                                               Padding="0"
                                               Margin="2,0,8,0"
                                               IsEnabled="{Binding HasActiveService}"
                                               Command="{Binding ReloadActiveServiceCommand}"
                                               ToolTip="Reload">
                                        <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="15" />
                                    </ui:Button>
                                </StackPanel>

                                <controls:SearchTextBox Grid.Column="1"
                                                        Height="30"
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        Padding="10,4"
                                                        Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Service URL..."
                                                        KeyDown="AddressBar_KeyDown" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               Width="32"
                                               Height="32"
                                               Padding="0"
                                               IsEnabled="{Binding HasActiveService}"
                                               Command="{Binding OpenActiveInBrowserCommand}"
                                               ToolTip="Open in External Browser">
                                        <ui:SymbolIcon Symbol="Globe20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                               Width="32"
                                               Height="32"
                                               Padding="0"
                                               Margin="2,0,0,0"
                                               IsEnabled="{Binding HasActiveService}"
                                               Command="{Binding HibernateServiceCommand}"
                                               CommandParameter="{Binding ActiveService}"
                                               ToolTip="Hibernate Active Service">
                                        <ui:SymbolIcon Symbol="WeatherMoon20" FontSize="15" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- WebView2 Host Area -->
                        <Grid Grid.Row="1">
                            <!-- Empty / Hibernated State -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="48" Opacity="0.45" Margin="0,0,0,14" />
                                <TextBlock Text="Select a service or add a new one"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Inactive services stay lazy-loaded or hibernated at 0 MB WebView RAM."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,6,0,20"
                                           HorizontalAlignment="Center" />
                                <ui:Button Appearance="Primary"
                                           Content="Add Service"
                                           Padding="18,8"
                                           HorizontalAlignment="Center"
                                           Command="{Binding OpenAddServiceCommand}" />
                            </StackPanel>

                            <!-- Inline Locked Service State (shown when active service locks by user or timeout) -->
                            <Border Width="380"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="10"
                                    Padding="28"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    Visibility="{Binding ShowLockedPane, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Image Source="{Binding UnlockTargetService.IconImage}"
                                               Width="48"
                                               Height="48"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                                            <ui:SymbolIcon Symbol="LockClosed16" FontSize="12" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding UnlockTargetService.DisplayName}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding UnlockPromptSubtitle}"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,4,0,18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <!-- Passcode / Password inline unlock -->
                                    <StackPanel Visibility="{Binding IsUnlockSecretMode, Converter={StaticResource BoolToVisibility}}">
                                        <PasswordBox x:Name="InlineUnlockSecretBox"
                                                     Padding="10,8"
                                                     Margin="0,0,0,12"
                                                     PasswordChanged="UnlockSecretBox_PasswordChanged"
                                                     KeyDown="UnlockSecretBox_KeyDown" />
                                        <ui:Button Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Content="Unlock"
                                                   Command="{Binding SubmitServiceUnlockCommand}" />
                                    </StackPanel>

                                    <!-- Windows Hello inline unlock -->
                                    <ui:Button Appearance="Primary"
                                               HorizontalAlignment="Stretch"
                                               Content="Unlock with Windows Hello"
                                               Visibility="{Binding IsUnlockWindowsHelloMode, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding SubmitServiceUnlockCommand}" />

                                    <TextBlock Text="{Binding UnlockErrorMessage}"
                                               Foreground="#FF6B72"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding HasUnlockError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Blurred snapshot of active WebView2 shown behind translucent popups -->
                            <Image x:Name="WebViewBackdropSnapshot"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False">
                                <Image.Effect>
                                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                                </Image.Effect>
                            </Image>

                            <Grid x:Name="WebViewHostGrid" />

                            <!-- Loading Progress Bar -->
                            <ProgressBar Height="2"
                                         VerticalAlignment="Top"
                                         IsIndeterminate="True"
                                         Foreground="{Binding ProgressbarAccentColor, Converter={StaticResource HexToBrush}}"
                                         Visibility="{Binding ActiveService.IsLoading, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>

                    <!-- Right-hand Collapsible Ferdium Todos Drawer -->
                    <Border Grid.Column="2"
                            Width="340"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Visibility="{Binding IsTodosDrawerOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10,0">
                                <TextBlock Text="Ferdium Todos" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                           HorizontalAlignment="Right"
                                           Width="28" Height="28" Padding="0"
                                           Command="{Binding ToggleTodosDrawerCommand}"
                                           ToolTip="Close Todos">
                                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" />
                                </ui:Button>
                            </Grid>
                            <Grid x:Name="TodosWebViewHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FLYOUT / DIALOG OVERLAYS ==================== -->

        <!-- 0. WinUI 3 Settings Dialog (Full 7-Tab Ferdium Settings) -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#3D000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="OverlayBackdrop_MouseDown">
            <Border Width="820"
                    MaxHeight="720"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    MouseDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Settings"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ResourceFootprintText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <ui:Button Appearance="Secondary"
                                       Height="32"
                                       Padding="12,0"
                                       Margin="0,0,8,0"
                                       Command="{Binding ImportFromDefaultFerdiumCommand}"
                                       ToolTip="Import settings from %APPDATA%\Ferdium\config\settings.json">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Import Ferdium Settings" FontSize="12.5" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource WinUiSubtleButton}"
                                       Width="32"
                                       Height="32"
                                       Padding="0"
                                       Command="{Binding CloseAllOverlaysCommand}"
                                       ToolTip="Close (Esc)">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- 7 Ferdium Settings Tabs + Import Status -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <WrapPanel>
                            <ui:Button Content="General"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=General}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="General" />
                            <ui:Button Content="Services"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Services}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Services" />
                            <ui:Button Content="Appearance"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Appearance}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Appearance" />
                            <ui:Button Content="Privacy"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Privacy}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Privacy" />
                            <ui:Button Content="Language"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Language}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Language" />
                            <ui:Button Content="Advanced"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Advanced}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Advanced" />
                            <ui:Button Content="Updates"
                                       Margin="0,0,6,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Updates}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Updates" />
                            <ui:Button Content="Extensions"
                                       Margin="0,0,0,6"
                                       Padding="14,6"
                                       CornerRadius="6"
                                       Appearance="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToAppearance}, ConverterParameter=Extensions}"
                                       Command="{Binding SelectSettingsTabCommand}"
                                       CommandParameter="Extensions" />
                        </WrapPanel>

                        <TextBlock Text="{Binding SettingsImportStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Margin="2,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Scrollable Tab Content -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="0,0,14,4">

                            <!-- ==================== 1. GENERAL TAB ==================== -->
                            <StackPanel Visibility="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=General}">
                                <TextBlock Text="Main" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Power24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Launch Ferdium on start" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Automatically start Ferdium when you sign in to Windows" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding AutoLaunchOnStart}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Window24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Keep Ferdium in background when closing the window" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Continue running services quietly in the background" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding RunInBackground}" IsEnabled="{Binding EnableSystemTray}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Shield24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Confirm when quitting Ferdium" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Ask for confirmation before exiting the application" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ConfirmOnQuit}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon TrayItemAdd24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Always show Ferdium in System Tray" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Display the Ferdium icon in the Windows notification area" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding EnableSystemTray}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon ArrowClockwise24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Reload Ferdium after system resume" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Refresh loaded services when waking from sleep or suspension" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ReloadAfterResume}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Timer24}"
                                                Visibility="{Binding ReloadAfterResume, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Time to consider the system as idle/suspended (in minutes)" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Minimum suspension duration before reloading services" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Width="90" Text="{Binding ReloadAfterResumeTime, UpdateSourceTrigger=PropertyChanged}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Window24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Start minimized" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Launch Ferdium minimized on startup" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" IsEnabled="{Binding EnableSystemTray}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon TrayItemAdd24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Minimize Ferdium to system tray" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Hide the taskbar button and send Ferdium to the system tray on minimize" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding MinimizeToSystemTray}" IsEnabled="{Binding EnableSystemTray}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon TrayItemAdd24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Close Ferdium to system tray" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Clicking the close button hides Ferdium to the notification area" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding CloseToSystemTray}" IsEnabled="{Binding EnableSystemTray}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Grid24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Keep all workspaces loaded" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Keep services from inactive workspaces loaded in memory" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding KeepAllWorkspacesLoaded}" />
                                </ui:CardControl>

                                <TextBlock Text="Ferdium Todos &amp; Do-Not-Disturb" Style="{StaticResource SettingsSectionHeader}" />

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon CheckmarkCircle24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Enable Ferdium Todos" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Enable integrated todo panel support" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding EnableTodos}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Globe24}"
                                                Visibility="{Binding EnableTodos, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Todo Server" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Select a predefined todo service or use a custom server URL" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding PredefinedTodoServerOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding PredefinedTodoServer}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Globe24}"
                                                Visibility="{Binding IsCustomTodoServer, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Custom Todo Server URL" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="This server will be used for the Ferdium Todo feature" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Width="260" PlaceholderText="https://todo.example.com" Text="{Binding CustomTodoServer, UpdateSourceTrigger=PropertyChanged}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Alert24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Enable scheduled Do-not-Disturb" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Automatically mute notifications and audio during a scheduled 24-hour window" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ScheduledDndEnabled}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Clock24}"
                                                Visibility="{Binding ScheduledDndEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Scheduled DND window (24-hour format)" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="End time can be before start time (e.g. 17:00 to 09:00) for overnight DND" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox Width="84" PlaceholderText="17:00" Text="{Binding ScheduledDndStart, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:TextBox Width="84" PlaceholderText="09:00" Text="{Binding ScheduledDndEnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </ui:CardControl>
                            </StackPanel>

                            <!-- ==================== 2. SERVICES TAB ==================== -->
                            <StackPanel Visibility="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Services}">
                                <TextBlock Text="Service Icons Settings" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Apps24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show disabled services" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Keep disabled services visible in the sidebar" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ShowDisabledServices}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon PanelLeft24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show service names in sidebar" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Expand the navigation rail to display labels beside service icons" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ShowServiceNames}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Color24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Use grayscale service icons" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Desaturate inactive service icons to reduce visual distraction" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding UseGrayscaleServices}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}"
                                                Icon="{ui:SymbolIcon Color24}"
                                                Visibility="{Binding UseGrayscaleServices, Converter={StaticResource BoolToVisibility}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Grayscale dim intensity" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="{Binding GrayscaleServicesDim, StringFormat='{}{0}%'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <Slider Width="160" Minimum="0" Maximum="100" Value="{Binding GrayscaleServicesDim}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Alert24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show message badge when muted" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Continue showing unread counters even when a service is muted" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding ShowMessageBadgeWhenMuted}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Apps24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Service icon size" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Adjust the size of service icons in the sidebar" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="190"
                                              ItemsSource="{Binding IconSizeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding IconSize}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Navigation24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Navigation bar behaviour" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Control when the Back, Forward, Reload, and URL bar is shown" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="260"
                                              ItemsSource="{Binding NavigationBarBehaviourOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding NavigationBarBehaviour}" />
                                </ui:CardControl>

                                <!-- Performance & Hibernation -->
                                <Grid Margin="0,20,0,8">
                                    <TextBlock Text="Performance &amp; Hibernation" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ui:Button Appearance="Secondary" HorizontalAlignment="Right" Padding="12,6" Command="{Binding HibernateInactiveServicesCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Broom20" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Hibernate inactive now" FontSize="12.5" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Flash24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Lazy-load inactive services" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Only spawn a WebView2 process when you first open a service" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding LazyLoadServices}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon TopSpeed24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Suspend background WebViews (TrySuspendAsync)" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Freeze hidden services to cut idle CPU (pauses background notifications until you switch back)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding SuspendBackgroundWebViews}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Broom24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Trim cache &amp; memory on hibernate" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Clear HTTP/disk cache and collect GC when hibernating while keeping logins intact" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding TrimMemoryOnHibernate}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Timer24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Hibernation strategy" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="{Binding AutoHibernateSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="250"
                                              ItemsSource="{Binding HibernationStrategyOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding HibernationStrategySeconds}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Power24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Hibernate on startup" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Keep services hibernated when Ferdium launches" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding HibernateOnStartup}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Clock24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Wake up strategy" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Periodically wake hibernated services to check for new messages" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding WakeUpStrategyOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding WakeUpStrategySeconds}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Clock24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Wake up hibernation strategy" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="How long a woken service stays active before hibernating again" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="250"
                                              ItemsSource="{Binding WakeUpHibernationStrategyOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding WakeUpHibernationStrategySeconds}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Clock24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Splay wake-up hibernation timers" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Stagger background service wake-ups to avoid simultaneous CPU spikes" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding WakeUpHibernationSplay}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Apps24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Enable long-press service hint" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Display extended service hint details on sidebar hover/press" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding EnableLongPressServiceHint}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Shield24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Sandbox services (isolated profiles)" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Run each service in its own isolated WebView2 profile directory (recommended)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding SandboxServices}" />
                                </ui:CardControl>
                            </StackPanel>

                            <!-- ==================== 3. APPEARANCE TAB ==================== -->
                            <StackPanel Visibility="{Binding ActiveSettingsTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Appearance}">
                                <TextBlock Text="General UI" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Color24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="App theme" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Follow Windows theme automatically or force Light / Dark mode" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox Width="170" SelectedIndex="{Binding ThemeModeIndex}">
                                        <ComboBoxItem Content="Use system setting" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Window24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Windows 11 Mica backdrop" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Use native DWM Mica shell material with zero CPU blur overhead" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding UseMica}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon WeatherMoon24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Universal Dark Mode" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Dynamically generate dark mode styles for services without native dark mode" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding UniversalDarkMode}" />
                                </ui:CardControl>

                                <ui:CardControl Style="{StaticResource WinUiSettingsCard}" Icon="{ui:SymbolIcon Grid24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Split Mode" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="Display multiple services side by side" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
