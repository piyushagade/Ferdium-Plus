<Application x:Class="FerdiumApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:FerdiumApp.Converters"
             xmlns:controls="clr-namespace:FerdiumApp.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type controls:SearchTextBox}"
                   BasedOn="{StaticResource {x:Type ui:TextBox}}" />

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:HibernatedOpacityConverter x:Key="HibernatedOpacity" />
            <conv:UrlToFaviconUriConverter x:Key="UrlToFaviconUri" />
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility" />
            <conv:StringEqualsToAppearanceConverter x:Key="StringEqualsToAppearance" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
